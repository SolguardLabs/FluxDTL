{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rust: fmt check",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "rust: build",
      "type": "shell",
      "command": "cargo build --all-targets --locked",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust: test",
      "type": "shell",
      "command": "cargo test --locked",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust: clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets --all-features --locked -- -D warnings",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "node: test",
      "type": "shell",
      "command": "node --test \"tests/node/*.test.js\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ci: local",
      "type": "shell",
      "command": "bash scripts/ci.sh",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
