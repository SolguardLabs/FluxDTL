{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flux DTL demo",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "flux-dtl"],
        "filter": {
          "name": "flux-dtl",
          "kind": "bin"
        }
      },
      "args": ["demo"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flux DTL demo JSON",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "flux-dtl"],
        "filter": {
          "name": "flux-dtl",
          "kind": "bin"
        }
      },
      "args": ["demo-json"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
