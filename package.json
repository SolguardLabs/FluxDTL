{
    "name": "flux-dtl",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "SDK y controles de integración para FluxDTL",
    "scripts": {
        "test": "node scripts/run-node-tests.mjs",
        "test:rust": "cargo test --all-targets --locked",
        "test:all": "npm run test:rust && npm test",
        "ci": "npm run fmt:check && npm run build && cargo build --all-targets --locked && npm run test:all && cargo clippy --all-targets --all-features --locked -- -D warnings && npm run verify:release",
        "build": "node scripts/check-js.mjs",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"**/*.{js,mjs,json,md,yml}\"",
        "fmt:check": "cargo fmt --all -- --check && prettier --check --config .prettierrc --ignore-path .prettierignore \"**/*.{js,mjs,json,md,yml}\"",
        "verify:release": "node scripts/verify-release.mjs"
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    }
}
